state_province: Maine
city: Calais
repository: National Archives and Records Administration (NARA)
repository_ref: T623 Roll 593 ED 186 Sheet 4A-4B
master_asset: '[[1900-06-01_Census_Whalen-JohnWarren-Household_CalaisME_NARA-T623_Master.pdf]]'
display_asset: '[[1900-06-01_Census_Whalen-JohnWarren-Household_CalaisME_NARA-T623_Display.jpg]]'
inference_asset: '[[1900-06-01_Census_Whalen-JohnWarren-Household_CalaisME_NARA-T623_Inference.png]]'
